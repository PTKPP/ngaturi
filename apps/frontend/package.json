{
  "name": "@ngaturi/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "templates:generate": "node scripts/generate-template-registry.mjs",
    "templates:check": "node scripts/generate-template-registry.mjs --check",
    "predev": "npm run templates:generate",
    "dev": "next dev",
    "prebuild": "npm run templates:generate",
    "build": "next build",
    "start": "next start",
    "prelint": "npm run templates:generate",
    "lint": "eslint .",
    "pretypecheck": "npm run templates:generate",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run templates:generate",
    "test": "vitest run",
    "supabase:start": "supabase start --workdir ../..",
    "supabase:reset": "supabase db reset --workdir ../.. --local",
    "test:supabase:image": "node scripts/test-local-image-media-workflow.mjs",
    "test:supabase:lifecycle": "node scripts/test-local-media-lifecycle.mjs",
    "test:supabase:operations": "node scripts/test-local-media-operations-quota.mjs",
    "test:supabase:audio": "node scripts/test-local-audio-media-workflow.mjs",
    "test:supabase:rsvp": "node scripts/test-local-rsvp-workflow.mjs",
    "test:supabase:wishes": "node scripts/test-local-wishes-workflow.mjs",
    "test:supabase": "npm run test:supabase:image && npm run test:supabase:lifecycle && npm run test:supabase:operations && npm run test:supabase:audio && npm run test:supabase:rsvp && npm run test:supabase:wishes",
    "media:cleanup": "node --conditions=react-server --import tsx scripts/run-media-cleanup.ts",
    "media:cleanup:scheduler": "node --conditions=react-server --import tsx scripts/run-media-cleanup.ts --schedule"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "next": "16.3.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "^0.0.1",
    "tsx": "4.23.12",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "jsdom": "29.1.1",
    "supabase": "2.116.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.26"
  }
}
