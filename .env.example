# Next.js + Supabase (copy the required names to apps/frontend/.env.local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Server-only HMAC secret for RSVP source fingerprints; use a random production value.
RSVP_RATE_LIMIT_SECRET=
NEXT_PUBLIC_SITE_URL=
NGATURI_ALLOWED_DEV_ORIGINS=
FRONTEND_HOST=
FRONTEND_PORT=

# Production media cleanup scheduler (PM2 app: ngaturi-media-cleanup)
# Non-local execution requires the explicit safety acknowledgement below.
MEDIA_CLEANUP_ALLOW_REMOTE=
MEDIA_CLEANUP_INTERVAL_MS=300000
MEDIA_CLEANUP_BATCH_SIZE=25
MEDIA_CLEANUP_CONCURRENCY=4
MEDIA_CLEANUP_MAX_BATCHES=20
MEDIA_CLEANUP_MAX_ATTEMPTS=8
MEDIA_CLEANUP_LEASE_TIMEOUT=10 minutes
MEDIA_CLEANUP_RUN_LOCK_LEASE=30 minutes
MEDIA_RECONCILE_BATCH_SIZE=100
MEDIA_UPLOAD_TIMEOUT=2 hours
MEDIA_PROCESSING_TIMEOUT=1 hour
MEDIA_FAILED_RETENTION=24 hours
MEDIA_READY_ORPHAN_GRACE=7 days
MEDIA_REFERENCE_RECHECK_INTERVAL=1 hour

# Optional local knowledge index
CHROMA_HOST=
CHROMA_PORT=
CHROMA_COLLECTION=
KNOWLEDGE_EMBEDDING_PROVIDER=
KNOWLEDGE_EMBEDDING_MODEL=
KNOWLEDGE_TOP_K=
KNOWLEDGE_MAX_CONTEXT_CHARS=
KNOWLEDGE_CHUNK_TARGET_TOKENS=
KNOWLEDGE_CHUNK_OVERLAP_TOKENS=

# Legacy Go auth service only; not part of the active invitation architecture
DATABASE_URL=
JWT_SECRET=
HTTP_ADDR=
ACCESS_TOKEN_TTL=
REFRESH_TOKEN_TTL=
