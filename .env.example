CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=digital-invitation-knowledge

# Backend API (TASK-002)
DATABASE_URL=postgres://ngaturi:ngaturi@localhost:5432/ngaturi?sslmode=disable
# Use a distinct random value of at least 32 bytes outside local development.
JWT_SECRET=replace-with-a-local-development-secret-at-least-32-bytes
HTTP_ADDR=:8080
# Access tokens stay valid until expiry after logout; refresh sessions are revoked on logout.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# local/default is suitable for local development. Configure a provider and model
# supported by the selected Chroma embedding function when using a remote provider.
KNOWLEDGE_EMBEDDING_PROVIDER=local
KNOWLEDGE_EMBEDDING_MODEL=all-MiniLM-L6-v2
KNOWLEDGE_TOP_K=6
KNOWLEDGE_MAX_CONTEXT_CHARS=12000
KNOWLEDGE_CHUNK_TARGET_TOKENS=700
KNOWLEDGE_CHUNK_OVERLAP_TOKENS=100
